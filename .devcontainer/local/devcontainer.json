{
  "name": "CodeBoarding (local, host mounts)",
  "image": "mcr.microsoft.com/devcontainers/python:1.2.8-3.12-bookworm",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/node:1.7.1": {
      "version": "20"
    },
    "ghcr.io/devcontainers-extra/features/uv:1.0.2": {
      "version": "0.13.5"
    }
  },
  "mounts": [
    {
      "source": "codeboarding-home-${devcontainerId}",
      "target": "/home/vscode/.codeboarding",
      "type": "volume"
    },
    {
      "source": "${localEnv:HOME}/.claude",
      "target": "/home/vscode/.claude",
      "type": "bind"
    },
    "source=${localEnv:HOME}/.ssh/known_hosts,target=/etc/ssh/ssh_known_hosts,type=bind,readonly"
  ],
  "containerEnv": {
    "DO_NOT_TRACK": "1",
    "UV_LINK_MODE": "copy",
    "UV_PYTHON_DOWNLOADS": "never",
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv"
  },
  "remoteEnv": {
    "PATH": "/home/vscode/.venv/bin:${containerEnv:PATH}"
  },
  "initializeCommand": "mkdir -p \"${localEnv:HOME}/.claude\" && mkdir -p -m 700 \"${localEnv:HOME}/.ssh\" && touch \"${localEnv:HOME}/.ssh/known_hosts\"",
  "forwardPorts": [8080],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "ms-python.mypy-type-checker",
        "anthropic.claude-code"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter",
          "editor.formatOnSave": true
        },
        "black-formatter.importStrategy": "fromEnvironment",
        "mypy-type-checker.importStrategy": "fromEnvironment"
      }
    }
  }
}
